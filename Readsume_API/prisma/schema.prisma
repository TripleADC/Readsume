generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model FieldTags {
  id          Int           @id @default(autoincrement())
  created_at  DateTime      @default(now()) @db.Timestamptz(6)
  fieldName   String?
  ResumeField ResumeField[]
  UserField   UserField[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Resume {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  object_key       String?
  created_by       String?          @db.Uuid
  created_at       DateTime         @default(now()) @db.Timestamptz(6)
  public           Boolean?         @default(true)
  engagement_score BigInt?          @default(0)
  public_url       String?
  thumbnail_url    String?
  Users            Users?           @relation(fields: [created_by], references: [id], onDelete: Cascade, onUpdate: NoAction)
  ResumeComments   ResumeComments[]
  ResumeField      ResumeField[]
  UserResume       UserResume[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model ResumeComments {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at    DateTime        @default(now()) @db.Timestamptz(6)
  for_resume    String?         @db.Uuid
  created_by    String?         @db.Uuid
  comment       String?
  position_top  Decimal?        @db.Decimal
  position_left Decimal?        @db.Decimal
  box_width     Decimal?        @db.Decimal
  box_height    Decimal?        @db.Decimal
  edited_at     DateTime?       @db.Timestamptz(6)
  Users         Users?          @relation(fields: [created_by], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Resume        Resume?         @relation(fields: [for_resume], references: [id], onDelete: Cascade, onUpdate: NoAction)
  ResumeReplies ResumeReplies[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model ResumeField {
  id         Int        @id @default(autoincrement())
  created_at DateTime   @default(now()) @db.Timestamptz(6)
  resume     String?    @db.Uuid
  field      Int?
  FieldTags  FieldTags? @relation(fields: [field], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Resume     Resume?    @relation(fields: [resume], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model ResumeReplies {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at          DateTime        @default(now()) @db.Timestamptz(6)
  for_comment         String?         @db.Uuid
  created_by          String?         @db.Uuid
  reply               String?
  edited_at           DateTime?       @db.Timestamptz(6)
  for_reply           String?         @db.Uuid
  deleted_at          DateTime?       @db.Timestamptz(6)
  Users               Users?          @relation(fields: [created_by], references: [id], onDelete: Cascade, onUpdate: NoAction)
  ResumeComments      ResumeComments? @relation(fields: [for_comment], references: [id], onDelete: Cascade, onUpdate: NoAction)
  ResumeReplies       ResumeReplies?  @relation("ResumeRepliesToResumeReplies", fields: [for_reply], references: [id], onDelete: Cascade, onUpdate: NoAction)
  other_ResumeReplies ResumeReplies[] @relation("ResumeRepliesToResumeReplies")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model UserField {
  id         Int        @id @default(autoincrement())
  created_at DateTime   @default(now()) @db.Timestamptz(6)
  user       String?    @db.Uuid
  field      Int?
  FieldTags  FieldTags? @relation(fields: [field], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Users      Users?     @relation(fields: [user], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model UserResume {
  id             BigInt   @id @default(autoincrement())
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  logged_in_user String?  @db.Uuid
  resume         String?  @db.Uuid
  rejected       Boolean? @default(false)
  Users          Users?   @relation(fields: [logged_in_user], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Resume         Resume?  @relation(fields: [resume], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Users {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at     DateTime         @default(now()) @db.Timestamptz(6)
  auth0_id       String?
  display_name   String?
  number_id      String?
  Resume         Resume[]
  ResumeComments ResumeComments[]
  ResumeReplies  ResumeReplies[]
  UserField      UserField[]
  UserResume     UserResume[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model DisplayNameOptions {
  id          Int      @id @default(autoincrement())
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  animal_name String?
}
